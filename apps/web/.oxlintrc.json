{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json", "./node_modules/@foldkit/oxlint-plugin/recommended.json"],
  "rules": {
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "story", "scene"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/server/**/*.ts", "src/worker.ts"],
      "rules": {
        "typescript/consistent-type-assertions": "off"
      }
    }
  ]
}
