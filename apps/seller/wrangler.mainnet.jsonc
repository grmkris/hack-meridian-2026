{
  // PREPARED, NOT DEPLOYED. Mainnet moves real money: deploy only on Kristjan's explicit go, with
  //   bunx wrangler deploy -c wrangler.mainnet.jsonc --secrets-file .dev.vars.mainnet
  // Until the placeholders below are filled from docs/research/mainnet.md the Worker answers 503 with the problems.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hm26-seller-mainnet",
  "account_id": "bceaeae4788dce3493514fde194b4a7e",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "STELLAR_NETWORK": "pubnet",
    // a mainnet G with a USDC trustline (Circle issuer GA5ZSEJY…KZVN); placeholder fails validation on purpose
    "PAY_TO": "SET_MAINNET_PAYTO_G_ACCOUNT",
    // USDC SAC: the preset CCW67TSZ…MI75 (docs/research/mainnet.md and @x402/stellar 2.28.0 agree)
    // x402.org has no pubnet: OpenZeppelin Channels is the facilitator, key OZ_FACILITATOR_KEY in .dev.vars.mainnet
    // (bun scripts/demo/oz-key.ts --network pubnet; never printed)
    "OZ_FACILITATOR_URL": "https://channels.openzeppelin.com/x402",
    "FACILITATOR": "oz",
  },
  "durable_objects": { "bindings": [{ "name": "PAYMENT_IDS", "class_name": "PaymentIds" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PaymentIds"] }],
}
