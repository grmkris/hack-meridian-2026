{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 120,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [{ "groupName": "scoped", "elementNamePattern": ["@*", "@*/**"] }],
    "groups": [["builtin", "external"], "scoped", ["parent", "sibling", "index"], "unknown"]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "repos",
    "spikes/**",
    "evidence/**",
    "contracts/target",
    "contracts/**/test_snapshots",
    "packages/counter-client",
    "apps/web/src/server/cards/*.html",
    ".agents/skills",
    ".claude/skills",
    ".codex",
    ".cursor",
    "bun.lock",
    "*.tsbuildinfo"
  ]
}
