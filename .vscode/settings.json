{
  // TypeScript language features run on the pinned TypeScript 7 compiler. The native preview extension starts this
  // launcher, which runs the repository's tsrs package. Oxc runs the repository's oxlint and the pinned tsrs-lint.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./.vscode/tsrs",
  "oxc.enable.oxlint": true,
  "oxc.path.tsgolint": "${userHome}/.cache/tsrs-lint/lint-pr624-0acc433-regions.1/tsrs-lint"
}
