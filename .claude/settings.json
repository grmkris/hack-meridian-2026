{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.config/secrets.env)",
      "Read(~/.config/stellar/identity/**)",
      "Read(./.local/*.env)",
      "Read(./spikes/**/.env)",
      "Bash(*secrets.env*)",
      "Bash(stellar keys show*)",
      "Bash(stellar keys secret*)",
      "Bash(git stash*)",
      "Bash(git reset --hard*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git checkout --*)",
      "Bash(git checkout * --*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": []
  }
}
