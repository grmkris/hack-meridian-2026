# Generated by `bun src/setup.ts` into .env (gitignored). Secrets only; public keys are printed by setup.
SPONSOR_SECRET=   # relayer G: tx source + fee payer for every smart-account tx
SPONSOR2_SECRET=  # second relayer G (webauthn-demo runs beside demo without sequence contention)
FUNDER_SECRET=    # G with USDC trustline; buys USDC on the testnet SDEX and funds the C-accounts
OWNER_SECRET=     # Ed25519 stand-in for the passkey (rule 0 of the demo.ts account)
CONN_SECRET=      # connection key: rule signer AND its own classic "pocket" G (friendbot + USDC trustline)
MERCHANT_SECRET=  # recipient G with USDC trustline
PASSKEY_PKCS8=    # software P-256 passkey (webauthn-demo.ts), base64 PKCS#8
PASSKEY_CRED_ID=  # its credential id, base64url
PASSKEY_ACCOUNT_ID= # C-account whose rule 0 is that passkey
# ACCOUNT_ID=     # optional: reuse a demo.ts account instead of deploying a fresh one
